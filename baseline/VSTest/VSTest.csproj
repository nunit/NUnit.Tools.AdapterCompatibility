<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <AssemblyName>AdapterCompatibility.VSTest</AssemblyName>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shared/CompatibilityCases.cs" Link="CompatibilityCases.cs" />
    <PackageReference Include="NUnit" Version="$(BaselineFrameworkVersion)" />
    <PackageReference Include="NUnit3TestAdapter" Version="$(AdapterVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net462'" />
  </ItemGroup>
</Project>
